    "import pandas as pd\n",
    "\n",
    "# Use absolute path for `adult.data`\n",
    "file_path = 'c:/Users/shabiga/scaling_to_production/05_src/data/adult/adult.data'\n",
    "\n",
    "columns = [\n",
    "    'age', 'workclass', 'fnlwgt', 'education', 'education-num', 'marital-status',\n",
    "    'occupation', 'relationship', 'race', 'sex', 'capital-gain', 'capital-loss', 'hours-per-week',\n",
    "    'native-country', 'income'\n",
    "]\n",
    "try:\n",
    "    adult_dt = (pd.read_csv(file_path, header=None, names=columns)\n",
    "                .assign(income=lambda x: (x['income'].str.strip() == '>50K').astype(int)))\n",
    "    print(\"Data loaded successfully.\")\n",
    "except FileNotFoundError:\n",
    "    print(f\"Error: File not found at {file_path}\")\n",
    "except Exception as e:\n",
    "    print(f\"Error: {e}\")"
   ]
  },
