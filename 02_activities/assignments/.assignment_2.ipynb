       "ColumnTransformer(transformers=[('num_transforms',\n",
       "                                 Pipeline(steps=[('imputer',\n",
       "                                                  KNNImputer(n_neighbors=7,\n",
       "                                                             weights='distance')),\n",
       "                                                 ('scaler', RobustScaler())]),\n",
       "                                 ['age']),\n",
       "                                ('cat_transforms',\n",
       "                                 Pipeline(steps=[('imputer',\n",
       "                                                  SimpleImputer(strategy='most_frequent')),\n",
       "                                                 ('encoder',\n",
       "                                                  OneHotEncoder(drop='if_binary'))]),\n",
       "                                 ['workclass', 'education'])])"
      ]
